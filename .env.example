# Copy this file to .env.local and fill in your real values.
# .env.local is already excluded from Git — never commit real credentials.
#
# Both values below are found in your Supabase project dashboard under
# Project Settings -> API. They are the PUBLIC/publishable pair, safe to
# expose in browser code — never put a service_role / secret key here.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Milestone 8 — Payments, Invoicing and Receipts (Razorpay)
# ---------------------------------------------------------------------------
# All three values below come from the Razorpay Dashboard (use TEST MODE
# keys while developing — never live/production keys in a shared or
# non-production environment). Settings -> API Keys gives you Key ID/Key
# Secret; Settings -> Webhooks gives you the webhook secret once you create
# a webhook pointing at https://<your-domain>/api/webhooks/razorpay.
#
# RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET must NEVER be prefixed
# with NEXT_PUBLIC_ — doing so would ship them to the browser. Only
# RAZORPAY_KEY_ID is ever sent to the client (Razorpay's Checkout.js needs
# it to open the payment modal; it is not a secret).
#
# The app builds and runs fine with these unset — payment actions simply
# show a "Payment gateway is not configured" state instead of crashing. See
# docs/payments-billing-guide.md for the full setup walkthrough, including
# the one-time database bootstrap step (supabase/migrations/0005_payments_billing.sql's
# BOOTSTRAP section) that must ALSO be done — these env vars alone are not
# sufficient, since checkout/webhook verification reads the same two
# secrets from a database table, not from process.env, at verification time.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Absolute base URL of this deployment (no trailing slash), e.g.
# https://app.nextwise.example — used to build the copyable "pay this
# invoice" links admins generate, and as the canonical site URL for page
# metadata (src/config/site.ts SITE_URL, Open Graph tags, etc.). Falls back
# to a relative path (still usable within the app) when unset. Defaulted to
# the standard local dev server URL below — change this to your real
# deployment URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Milestone 9 — Global University and Course Data Platform (CLI tools only)
# ---------------------------------------------------------------------------
# These two values back the three `*-education-data` npm scripts
# (validate:education-data, import:education-data, seed:education-data —
# see docs/global-education-data-guide.md and scripts/*-education-data.ts).
# They are NEVER prefixed with NEXT_PUBLIC_ and are NEVER used by the
# Next.js app itself — the app writes only through the logged-in user's own
# RLS-scoped session (src/lib/supabase/server.ts), never a service-role
# bypass. ONLY the scripts/*-education-data.ts CLI tools in this milestone
# read these, run locally or in a trusted CI job — never in the browser.
# NEVER commit real values for either of these to source control.
#
# SUPABASE_SERVICE_ROLE_KEY: Settings -> API -> service_role secret in your
# Supabase project dashboard. Bypasses Row Level Security by design — used
# only by scripts/import-education-data.ts to write universities/courses
# rows directly, outside the Admin UI.
SUPABASE_SERVICE_ROLE_KEY=

# SUPABASE_DB_URL: Database Settings -> Connection string -> URI in your
# Supabase project dashboard, with the database password filled in. Used
# only by scripts/seed-education-data.ts to apply
# supabase/seed/0003_global_education_dev_seed.sql via a raw Postgres
# connection.
SUPABASE_DB_URL=